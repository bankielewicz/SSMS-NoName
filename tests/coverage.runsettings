<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage for the parts that can run outside SSMS: the NoName.Diagnostics.Core library.
     The VSIX runs only inside SSMS 22 and is checked by the diagnostic run instead
     (docs/specs/noname/feasibility-spike.md). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[NoName.Diagnostics.Core]*</Include>
          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>false</DeterministicReport>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
