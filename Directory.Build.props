<Project>
  <!-- WSL (dotnet) and Windows (MSBuild for the VSIX) build the same tree; keep their restore
       and build outputs apart so neither overwrites the other's project.assets.json. -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <BaseIntermediateOutputPath>obj.win\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin.win\</BaseOutputPath>
  </PropertyGroup>

  <!-- Each OS must not compile the other's generated files (e.g. obj/*.AssemblyInfo.cs). -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;obj.win/**;bin/**;bin.win/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Nothing here is published as a package, so skip SourceLink's git queries (they also fail on
       the placeholder files Claude Code's sandbox mounts over the repo root). -->
  <PropertyGroup>
    <EnableSourceLink>false</EnableSourceLink>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
  </PropertyGroup>
</Project>
